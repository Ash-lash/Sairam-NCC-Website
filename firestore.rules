rules_version = '2'
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL RULES ---
    // Allow public read for all collections so visitors can see the website
    // But strictly restrict write access to authenticated administrators
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // --- COLLECTION SPECIFIC RULES (Granular Control) ---
    
    // Alumni Data: Personal information is sensitive
    match /alumni/{alumniId} {
      allow read: if true;
      // Only the specific alumni can update their profile OR an admin
      allow update, delete: if request.auth != null && (request.auth.uid == alumniId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Admin Logs & Sensitive Configs: No public access
    match /admin_logs/{logId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Mentor registrations
    match /mentor_registrations/{regId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Join Sairam NCC registrations
    match /registrations/{regId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Blogs Public Interactions
    match /blogs/{blogId} {
      // Allow update if only views and/or likes are being modified
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'views']);
    }

    match /blog_interactions/{interactionId} {
      allow read, write: if true;
    }
  }
}
